{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "types": ["vite/client", "node"],
    "allowImportingTsExtensions": true,
    "baseUrl": ".",
    "paths": {
      "@grok-build-web/task-model": ["../../packages/task-model/src/index.ts"],
      "@grok-build-web/acp-protocol": ["../../packages/acp-protocol/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "vite.config.ts", "playwright.e2e.mts"]
}
